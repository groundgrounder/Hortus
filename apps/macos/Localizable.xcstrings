    "Restore this file from the session snapshot" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Restore this file from the session snapshot"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "从会话快照还原此文件"}}}},
    "Reverse only this change" : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reverse only this change"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅反向还原此改动"}}}},
